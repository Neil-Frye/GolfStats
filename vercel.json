{
  "version": 2,
  "buildCommand": "bash vercel-build.sh",
  "installCommand": "pip install -r api/requirements.txt",
  "framework": null,
  "outputDirectory": ".vercel/output",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 10,
      "runtime": "python3.9",
      "includeFiles": [
        "api/index.py",
        "api/requirements.txt"
      ],
      "excludeFiles": [
        "**"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "PYTHONPATH": ".",
    "APP_ENVIRONMENT": "production",
    "SERVERLESS_MODE": "true"
  }
}