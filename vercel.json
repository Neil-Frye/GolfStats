{
  "version": 2,
  "buildCommand": "bash vercel-build.sh",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "PYTHONPATH": ".",
    "APP_ENVIRONMENT": "production",
    "SERVERLESS_MODE": "true"
  }
}