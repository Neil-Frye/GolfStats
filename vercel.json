{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "python3.9",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python@3.0.11",
      "config": {
        "runtime": "python3.9",
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "api/**",
          "backend/**/*.py",
          "backend/auth/**",
          "backend/database/**",
          "backend/models/**",
          "config/**"
        ],
        "excludeFiles": [
          "**/__pycache__/**",
          "**/*.pyc",
          "**/*.pyo",
          "**/*.pyd",
          "**/.pytest_cache/**",
          "**/tests/**",
          "**/selenium/**",
          "**/webdriver/**",
          "**/data/**",
          "**/logs/**",
          "**/docs/**"
        ]
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "PYTHONPATH": ".",
    "APP_ENVIRONMENT": "production"
  }
}