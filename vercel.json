{
  "version": 2,
  "buildCommand": "bash vercel-build.sh",
  "installCommand": "pip install -r api/requirements.txt",
  "framework": null,
  "outputDirectory": ".vercel/output",
  
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 10,
      "runtime": "python3.9",
      
      "includeFiles": [
        "api/index.py",
        "api/requirements.txt",
        "api/mock_scrapers.py"
      ],
      
      "excludeFiles": [
        "**" 
      ]
    }
  },
  
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  
  "env": {
    "PYTHONPATH": ".",
    "APP_ENVIRONMENT": "production",
    "SERVERLESS_MODE": "true",
    "VERCEL_STRICT_BUILD": "true"
  },
  
  "github": {
    "silent": false,
    "autoJobCancelation": true
  }
}